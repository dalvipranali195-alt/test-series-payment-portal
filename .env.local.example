# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never expose this to the client. Used by lib/supabase/admin.ts
# to invite new staff (Admin > Staff page). Keep it out of NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
